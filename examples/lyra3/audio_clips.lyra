# Native audio clips, looping, trimming and transformations.
tempo 120
sound modern

track clips {
  clip "../assets/clip_source.wav" at 0 length=2 trim_start=0.02 trim_end=0.9 fadein=0.1 fadeout=0.2 gain=-6 pitch=3 stretch=1.2 loop=true crossfade=15
  sample "../assets/clip_source.wav" 1 reverse=true gain=-9 fadeout=0.1
  fx highpass cutoff=70 wet=100
}
