# Multi-oscillator, unison, FM/AM, detune and full ADSR.
tempo 100
sound modern

track pad {
  osc saw level=65 detune=-4
  osc square level=25 detune=5 semitones=-12
  osc sine level=20 semitones=12
  unison 8 detune=14
  adsr 0.03 0.25 62 0.35
  fm 2 0.7
  am 3.5 18
  chord C4 E4 G4 B4 2
  chord A3 C4 E4 G4 2
}
