# Multi-oscillator, unison, FM/AM, detune and full ADSR.
tempo 100
sound modern

track pad {
  osc saw level=65 detune=-4
  osc square level=25 detune=5 semitones=-12
  osc sine level=20 semitones=12
  unison 8 detune=14
  adsr 0.03 0.25 62 0.35
  fm 2 0.7
  am 3.5 18
  chord C4 E4 G4 B4 2
  chord A3 C4 E4 G4 2
}

track modulated_texture {
  osc pink_noise level=14
  osc saw level=45
  filter bp 1800 60
  pitch_env 12 0
  filter_env 350 5200
  lfo sine 5 pitch 0.18
  lfo triangle 0.4 cutoff 900
  lfo random 2 pan 30
  adsr 0.01 0.15 45 0.25
  note C3 4
}
