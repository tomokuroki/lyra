    note D4 1
    note E4 0.5
    note F4 0.5
    note E4 1
    note C4 1
    note D4 1
    note E4 0.5
    note F4 0.5
    note E4 1
    note D4 1
    note C4 1
    note D4 1
    note G3 2

    # A returns
    note E4 1
    note E4 1
    note F4 1
    note G4 1
    note G4 1
    note F4 1
    note E4 1
    note D4 1
    note C4 1
    note C4 1
    note D4 1
    note E4 1
    note D4 1
    note C4 1
    note C4 2
  }
  chord C4 E4 G4 8
}

