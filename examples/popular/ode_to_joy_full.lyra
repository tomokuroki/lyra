# Ludwig van Beethoven — Ode to Joy (public-domain melody)
# Full Lyra arrangement: intro, three statements, growing orchestra, finale.
tempo 116
sound 64bit
volume 68
reverb 31
delay 1 7

# The famous 64-beat theme, stated three times on piano.
track main_melody {
  instrument piano
  volume 58
  rest 16
  loop 3 {
    # A
    note E4 1
    note E4 1
    note F4 1
    note G4 1
    note G4 1
    note F4 1
    note E4 1
    note D4 1
