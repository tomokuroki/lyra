# Lyra 2.1: lists, for-loops, key-aware degrees, chord symbols and articulation.
import "std/all.lyra"

const BPM = 108
const MOTIF = [1, 3, 5, 6, 5, 3, 2, 1]
const CHORDS = [Dm7, Bbmaj7, Fmaj7, C7]

instrument LivingLead extends BrightLead {
  attack 0.04
  release 0.28
  cutoff 4200
  drive 8
  pan 12
}

song TheoryDemo {
  tempo $BPM
  time 6/8
  key D minor
  sound 64bit
  use effect StreamingRelease
  use effect SmallRoom
  title "Lyra 2.1 Theory Demo"
  artist "Lyra Demo"

  track scale_melody uses LivingLead {
    repeat 4 {
      for step in MOTIF {
        degree $step 5 0.5
      }
    }
  }

  track symbolic_harmony uses SoftPiano {
    for chord in CHORDS {
      harmony $chord 3 4
    }
    for chord in CHORDS {
      harmony $chord 3 4
    }
  }

  track octave_lights {
    instrument glockenspiel
    volume 22
    pan 38
    for octave in range(4, 7) {
      note D$octave 1 velocity 55
      rest 1
    }
    rest 26
  }

  track bass uses DeepBass {
    repeat 4 {
      degree 1 2 2
      degree 6 1 2
      degree 3 2 2
      degree 7 1 2
    }
  }

  track drums {
    drumkit electronic
    volume 55
    repeat 16 {
      kick 0.5
      hihat 0.5
      snare 0.5
      hihat 0.5
    }
  }
}
