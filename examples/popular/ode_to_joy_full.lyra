track drums {
  volume 52
  rest 16

  # First statement: restrained orchestral pulse.
  drumkit orchestral
  loop 16 {
    timpani 2
    rest 2
  }

  # Second statement: steady popular-song groove.
  drumkit standard
  loop 16 {
    kick 1
    hihat 1
    snare 1
    hihat 1
  }

  # Finale: full rock/orchestral energy.
  drumkit rock
  crash 1
  hihat 1
  snare 1
  openhat 1
  loop 14 {
    kick 0.5
    hihat 0.5
    snare 0.5
    hihat 0.5
    kick 0.5
    hihat 0.5
    snare 0.5
    openhat 0.5
  }
  low_tom 1
  tom 1
  high_tom 1
  impact 1
  crash 8
}
