# Export, stem rendering, and offline audio-analysis example.
tempo 112
sound modern
peak -1

bus room {
  gain -8
  fx reverb time=67 feedback=0.48 wet=38
}

master {
  fx compressor threshold=-16 ratio=2.5 attack=8 release=140 wet=100
  fx limiter threshold=-1 wet=100
}

track lead {
  osc saw level=58
  unison 4 detune=9
  gain -5
  send room 24
  note C4 1
  note E4 1
  note G4 1
  note B4 1
}

track bass {
  osc square level=42 semitones=-12
  filter lp 520 35
  gain -7
  note C3 1
  note C3 1
  note G2 1
  note C3 1
}

track drums {
  gain -4
  kick 0.5
  hihat 0.5
  snare 0.5
  hihat 0.5
}
