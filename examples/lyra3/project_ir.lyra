# Lyra 3 project IR: mixer state, markers and deterministic automation.
tempo 120
tempo 90 at 2
time 4/4
grid 1/8
swing 60
section intro at 0 length 4

pattern motif() {
  note C5 0.5
  note E5 0.5
  note G5 0.5
  note B5 0.5
}

pattern sustain() {
  note C6 2
}

track lead {
  instrument piano
  gain -3
  pan 10
  marker intro 0
  automate volume at 0 40 linear
  automate volume at 4 100 linear
  automate cutoff at 0 1200 step
  automate cutoff at 4 6000 linear
  at 0
  play motif()
  at 2
  play sustain()
}

track guide {
  mute true
  wave sine
  note C4 4
}
